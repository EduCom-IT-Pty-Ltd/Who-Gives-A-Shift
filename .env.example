# ---------------------------------------------------------------------------
# Entra ID (one app registration — see SETUP-ENTRA.md)
# ---------------------------------------------------------------------------
# These three are inlined into the browser bundle at build time.
NEXT_PUBLIC_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Server-side copies of the same app registration, plus the secret.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Roles, driven by Entra security groups (comma-separated object IDs)
# ---------------------------------------------------------------------------
# Full access to every store, plus the Admin screen.
ENTRA_ADMIN_GROUP_IDS=
# Optional allow-list. Leave blank to let any tenant account sign in.
ENTRA_STAFF_GROUP_IDS=

# Per-store manager groups are set against each store on the Admin screen,
# not here.

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Mailbox the submission is sent *from*. Must be a real licensed mailbox.
GRAPH_SENDER_UPN=rosters@yourtenant.com.au
# Who reviews the submitted timesheets.
REVIEWER_EMAIL=ahaworth@educomit.com.au

# ---------------------------------------------------------------------------
# Database (Neon)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Signs the reviewer's link. Any long random string:  openssl rand -base64 48
REVIEW_LINK_SECRET=
# Only needed if the auto-detected Vercel URL is wrong (e.g. a custom domain).
APP_BASE_URL=
